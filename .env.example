# 阿里云百炼 API Key。不要把真实 Key 发给别人或提交到 Git。
DASHSCOPE_API_KEY=

# 默认兼容地址可以直接使用；如有百炼业务空间专属地址，可替换为专属地址。
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 必须是支持图片输入的 Qwen-VL 模型。
QWEN_API_MODEL=qwen3-vl-plus
QWEN_DISPLAY_NAME=Qwen3-VL API

# 0 表示第一张 NVIDIA 显卡；没有显卡时可临时改成 cpu（速度会明显降低）。
DETECTION_DEVICE=0

LOCAL_HOST=127.0.0.1
LOCAL_PORT=7860
